---
import Base from '../layouts/Base.astro';
import { proyectos } from '../data/proyectos.js';
import { site } from '../data/site.js';

const servicios = [
  {
    t: 'Decoración de tu casa',
    d: 'Decoración de interiores sin obras: elegimos y combinamos muebles, textiles, color y piezas para que tu casa se parezca a ti.',
  },
  {
    t: 'Asesoría de color y textil',
    d: 'Una paleta pensada para tu luz y tu forma de vivir, con los tejidos y texturas que la hacen real. También online.',
  },
  {
    t: 'Estilismo para marcas',
    d: 'Estilismo para marcas de mobiliario, decoración y textil hogar: catálogos, web y redes.',
  },
  {
    t: 'Home staging',
    d: 'Puesta en escena de viviendas para vender o alquilar antes: que se vean en su mejor versión, en las fotos y en la visita.',
  },
];

const pasos = [
  ['Escuchar', 'Me cuentas cómo vives tu casa, qué te sobra y qué echas de menos. Todo empieza aquí.'],
  ['Proponer', 'Te preparo una paleta y una selección de piezas a medida, aprovechando lo que ya tienes.'],
  ['Transformar', 'Lo llevamos a tu espacio, pieza a pieza, hasta que cada cosa tenga un motivo para estar.'],
];

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola Marta, me gustaría hablarte de mi casa.')}`
  : '';
---
<Base>
  <main>
    <section class="hero">
      <div class="hero-texto">
        <p class="eyebrow">Nº 01 — Decoradora y estilista de interiores</p>
        <h1>Tu casa,<br /><em>en su mejor versión</em></h1>
        <p class="sub">Decoración sin obras en Barcelona, el Vallès y el Maresme: con color, textiles y las piezas justas.</p>
        <div class="acciones">
          <a class="boton lleno" href="#contacto">Cuéntame tu casa</a>
          <a class="enlace" href="#proyectos">Ver proyectos</a>
        </div>
      </div>
      <figure class="hero-foto">
        <img src="/proyectos/va/va-02.webp" alt="Salón comedor con mesa de piedra, sillas de terciopelo verde y lámpara circular negra" fetchpriority="high" />
        <figcaption>Obra nueva, alma serena — salón comedor</figcaption>
      </figure>
    </section>

    <section class="intro">
      <p class="cita">
        Creo interiores coherentes y con carácter, donde cada pieza tiene <em>un motivo para estar</em>.
      </p>
      <p class="firma">— Marta</p>
    </section>

    <section id="proyectos" class="proyectos">
      <div class="seccion-cab">
        <h2>Proyectos</h2>
        <span class="contador">{String(proyectos.length).padStart(2, '0')}</span>
      </div>
      <div class="rejilla">
        {proyectos.map((p, i) => (
          <a href={`/proyectos/${p.slug}/`} class="tarjeta">
            <div class="foto">
              <img src={p.portada || p.fotos[0]} alt={`${p.titulo} — proyecto de decoración de interiores`} style={`object-position:${p.foco || 'center'}`} loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
            <div class="tarjeta-pie">
              <span class="numero">Nº {String(i + 1).padStart(2, '0')}</span>
              <div class="paleta" aria-hidden="true">
                {p.paleta.map(([, hex]) => <span style={`background:${hex}`}></span>)}
              </div>
            </div>
            <h3>{p.titulo}</h3>
            <p>{p.resumen}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="sin-obras">
      <figure class="sin-obras-foto">
        <img src="/proyectos/vp/vp-08.webp" alt="Salón blanco con mesas de roble y lámina en blanco y negro" />
      </figure>
      <div class="sin-obras-texto">
        <p class="eyebrow">Sin obras</p>
        <h2>No hace falta reformar para que tu casa cambie</h2>
        <p>
          Muchas casas no necesitan una reforma: necesitan una mirada. Con color, textiles,
          luz y una buena selección de piezas, el mismo espacio puede sentirse completamente nuevo.
          Y casi siempre partimos de lo que ya tienes.
        </p>
      </div>
    </section>

    <section id="servicios" class="servicios">
      <div class="seccion-cab">
        <h2>Servicios</h2>
        <span class="contador">{String(servicios.length).padStart(2, '0')}</span>
      </div>
      <ol class="indice">
        {servicios.map((sv, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{sv.t}</h3>
            <p>{sv.d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="proceso">
      <p class="eyebrow">Cómo trabajo</p>
      <ol>
        {pasos.map(([t, d], i) => (
          <li>
            <span class="paso-num">{['I', 'II', 'III'][i]}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="sobre" class="sobre">
      <figure class="sobre-foto">
        <img src="/marta.webp" alt="Marta, estilista de interiores" />
        <figcaption>Marta — estilista de interiores</figcaption>
      </figure>
      <div class="sobre-texto">
        <p class="eyebrow">Sobre mí</p>
        <h2>Hola, soy Marta</h2>
        <p class="entradilla">
          Llevo más de diez años dedicada a la decoración y el estilismo de espacios, y antes pasé quince
          en el sector textil.
        </p>
        <p>
          Esa experiencia me enseñó a mirar el detalle: la calidad de un tejido, el equilibrio entre
          texturas, la forma en que la luz transforma una estancia. Cada proyecto empieza escuchando.
          Entender cómo se vive un espacio es lo que permite darle una identidad propia, sin artificios.
        </p>
      </div>
    </section>

    <section id="contacto" class="contacto">
      <p class="eyebrow">Contacto</p>
      <h2>¿Hablamos de <em>tu casa</em>?</h2>
      <p class="contacto-sub">Cuéntame qué espacio quieres cambiar y lo imaginamos juntas.</p>
      <ul class="zonas">
        {site.zonas.map((z) => (
          <li>
            <h3>{z.nombre}</h3>
            <p>{z.detalle}</p>
          </li>
        ))}
      </ul>
      <div class="acciones">
        {whatsappUrl && <a class="boton lleno" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>}
       {site.email && <a class="boton" href={https://mail.google.com/mail/?view=cm&to=${site.email}`} target="_blank" rel="noopener">Email</a>}`
        <a class={`boton ${!whatsappUrl && !site.email ? 'lleno' : ''}`} href={site.instagram} target="_blank" rel="noopener">Escríbeme por Instagram</a>
      </div>
    </section>
  </main>
</Base>

<style>
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; }
  h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.04; font-weight: 300; }
  em { font-style: italic; }
  figure { margin: 0; }
  figcaption {
    margin-top: 0.7rem;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; }

  /* Portada tipo doble página */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
    max-width: 1500px;
    margin: 0 auto;
  }
  h1 {
    font-weight: 300;
    font-size: clamp(3.2rem, 7.4vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  .sub {
    margin: 1.8rem 0 2.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    color: var(--tinta-suave);
  }
  .hero-foto img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 68% center; }

  /* Cita */
  .intro {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) var(--gutter);
    text-align: center;
    border-top: 1px solid var(--linea);
  }
  .cita {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.22;
  }
  .firma { margin: 1.6rem 0 0; font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--tinta-suave); }

  /* Cabeceras de sección tipo revista */
  .seccion-cab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--tinta);
  }
  .contador { font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 2.5vw, 2rem); color: var(--tinta-suave); }

  /* Proyectos */
  .proyectos { max-width: 1320px; margin: 0 auto; padding: 0 var(--gutter) clamp(5rem, 11vw, 9rem); }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 5rem);
  }
  .tarjeta { text-decoration: none; display: block; }
  .tarjeta:nth-child(even) { margin-top: clamp(0rem, 9vw, 8rem); }
  .foto { overflow: hidden; aspect-ratio: 4 / 5; background: var(--arena); }
  .foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
  .tarjeta:hover .foto img { transform: scale(1.025); }
  .tarjeta-pie { display: flex; justify-content: space-between; align-items: center; margin: 1.1rem 0 0.6rem; }
  .numero { font-size: 0.68rem; letter-spacing: 0.24em; color: var(--tinta-suave); }
  .tarjeta h3 { font-size: clamp(1.7rem, 2.8vw, 2.3rem); font-weight: 400; line-height: 1.1; }
  .tarjeta p { margin: 0.5rem 0 0; color: var(--tinta-suave); font-size: 0.95rem; max-width: 46ch; }

  /* Sin obras */
  .sin-obras {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(5rem, 11vw, 9rem);
  }
  .sin-obras-foto img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; }
  .sin-obras-texto h2 { margin-bottom: 1.4rem; }
  .sin-obras-texto p:not(.eyebrow), .sobre-texto p:not(.eyebrow):not(.entradilla) {
    color: var(--tinta-suave);
    max-width: 46ch;
    margin: 0;
  }

  /* Servicios como índice */
  .servicios { max-width: 1320px; margin: 0 auto; padding: 0 var(--gutter) clamp(5rem, 11vw, 9rem); }
  .indice { list-style: none; margin: 0; padding: 0; }
  .indice li {
    display: grid;
    grid-template-columns: 4rem 1fr 1.3fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .num { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--tinta-suave); }
  .indice h3 { font-size: clamp(1.6rem, 2.8vw, 2.3rem); font-weight: 300; }
  .indice p { margin: 0; color: var(--tinta-suave); }

  /* Proceso */
  .proceso {
    background: var(--papel);
    padding: clamp(4.5rem, 10vw, 7.5rem) var(--gutter);
    text-align: center;
  }
  .proceso ol {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .paso-num { font-family: var(--serif); font-style: italic; font-size: 1.6rem; color: var(--tinta-suave); }
  .proceso h3 { font-size: clamp(2rem, 3.2vw, 2.6rem); font-weight: 300; margin: 0.4rem 0 0.8rem; }
  .proceso p { margin: 0 auto; color: var(--tinta-suave); max-width: 30ch; }

  /* Sobre mí */
  .sobre {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
  }
  .sobre-foto img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 40% top; }
  .sobre-texto h2 { margin-bottom: 1.6rem; }
  .entradilla {
    margin: 0 0 1.2rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.4;
  }

  /* Contacto */
  .contacto {
    text-align: center;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
    border-top: 1px solid var(--linea);
  }
  .contacto h2 { font-size: clamp(2.6rem, 7vw, 5.5rem); }
  .contacto-sub {
    margin: 1.4rem 0 2.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--tinta-suave);
  }
  .contacto .acciones { justify-content: center; }
  .zonas {
    list-style: none;
    margin: 0 auto 3rem;
    padding: 1.6rem 0 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--linea);
  }
  .zonas h3 { font-size: 1.35rem; font-weight: 400; margin-bottom: 0.3rem; }
  .zonas p { margin: 0; font-size: 0.82rem; color: var(--tinta-suave); line-height: 1.55; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-foto { order: -1; }
    .hero-foto img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 760px) {
    .rejilla { grid-template-columns: 1fr; }
    .tarjeta:nth-child(even) { margin-top: 0; }
    .sin-obras, .sobre { grid-template-columns: 1fr; }
    .indice li { grid-template-columns: 2.5rem 1fr; }
    .indice p { grid-column: 2; }
    .proceso ol { grid-template-columns: 1fr; }
    .zonas { grid-template-columns: 1fr 1fr; text-align: left; }
  }
</style>
