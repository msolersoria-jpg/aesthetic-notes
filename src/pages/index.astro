---
import Base from '../layouts/Base.astro';
import { proyectos as todos } from '../data/proyectos.js';
const proyectos = todos.filter((p) => p.portadaHome);
import { site } from '../data/site.js';
import Formulario from '../components/Formulario.astro';

const servicios = [
  {
    t: 'Asesoría & Personal Shopper',
    d: 'Te ayudo a elegir y comprar los textiles y la decoración que tu casa necesita, con criterio y sin errores caros.',
    url: '/asesoria-personal-shopper/',
    modalidades: [
      ['Online · Tu lista', 'desde 150 €'],
      ['De compras juntas', 'desde 190 €'],
      ['Lo hago yo', 'desde 290 €'],
    ],
  },
  {
    t: 'Decoración de tu casa',
    d: 'Decoración de interiores sin obras: muebles, textiles, color y piezas para que tu casa se parezca a ti.',
  },
  {
    t: 'Estilismo para marcas',
    d: 'Estilismo para marcas de mobiliario, decoración y textil hogar: catálogos, web y redes.',
  },
];

const pasos = [
  ['Escuchar', 'Me cuentas cómo vives tu casa, qué te sobra y qué echas de menos. Todo empieza aquí.'],
  ['Proponer', 'Te preparo una paleta y una selección de piezas a medida, aprovechando lo que ya tienes.'],
  ['Transformar', 'Lo llevamos a tu espacio, pieza a pieza, hasta que cada cosa tenga un motivo para estar.'],
];

const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola Marta, me gustaría hablarte de mi casa.')}`
  : '';
---
<Base>
  <main>
    <section class="hero">
      <div class="hero-texto">
        <h1>
          <span class="eyebrow">Nº 01 — Decoradora y estilista de interiores en Barcelona</span>
          Tu casa,<br /><em>en su mejor versión</em>
        </h1>
        <p class="sub">Asesoría de decoración y personal shopper, sin obras: online o en Barcelona, el Vallès y el Maresme.</p>
        <div class="acciones">
          <a class="boton lleno" href="/asesoria-personal-shopper/">Ver la asesoría</a>
          {site.llamada ? <a class="enlace" href={site.llamada} target="_blank" rel="noopener">Primera llamada gratuita</a> : <a class="enlace" href="#proyectos">Ver proyectos</a>}
        </div>
      </div>
      <figure class="hero-foto">
        <img src="/proyectos/va/va-02.webp" alt="Salón comedor con mesa de piedra, sillas de terciopelo verde y lámpara circular negra" fetchpriority="high" />
        <figcaption>Obra nueva, alma serena — salón comedor</figcaption>
      </figure>
    </section>

    <section class="intro">
      <p class="cita">
        Creo interiores coherentes y con carácter, donde cada pieza tiene <em>un motivo para estar</em>.
      </p>
      <p class="firma">— Marta</p>
    </section>

    <section id="proyectos" class="proyectos">
      <div class="seccion-cab">
        <h2>Proyectos</h2>
        <span class="contador">{String(proyectos.length).padStart(2, '0')}</span>
      </div>
      <div class="rejilla">
        {proyectos.map((p, i) => (
          <a href={`/proyectos/${p.slug}/`} class="tarjeta">
            <div class="foto">
              <img src={p.portadaHome} width="960" height="720" alt={`${p.titulo} — proyecto de decoración de interiores`} loading="lazy" />
            </div>
            <div class="tarjeta-pie">
              <span class="numero">Nº {String(i + 1).padStart(2, '0')}</span>
              <div class="paleta" aria-hidden="true">
                {p.paleta.map(([, hex]) => <span style={`background:${hex}`}></span>)}
              </div>
            </div>
            <h3>{p.titulo}</h3>
            <p>{p.resumen}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="servicios" class="servicios">
      <div class="seccion-cab">
        <h2>Servicios</h2>
        <span class="contador">{String(servicios.length).padStart(2, '0')}</span>
      </div>
      <ol class="indice">
        {servicios.map((sv, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{sv.url ? <a href={sv.url}>{sv.t}</a> : sv.t}</h3>
            <div class="sv-texto">
              <p>{sv.d}</p>
              {sv.modalidades && (
                <ul class="modalidades">
                  {sv.modalidades.map(([m, pr]) => <li><span>{m}</span><span class="pr">{pr}</span></li>)}
                </ul>
              )}
              {sv.url && <a class="enlace mas" href={sv.url}>Ver modalidades y precios</a>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="proceso">
      <p class="eyebrow">Cómo trabajo</p>
      <ol>
        {pasos.map(([t, d], i) => (
          <li>
            <span class="paso-num">{['I', 'II', 'III'][i]}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="sobre" class="sobre">
      <figure class="sobre-foto">
        <img src="/marta.webp" alt="Marta, estilista de interiores" />
        <figcaption>Marta — estilista de interiores</figcaption>
      </figure>
      <div class="sobre-texto">
        <p class="eyebrow">Sobre mí</p>
        <h2>Hola, soy Marta</h2>
        <p class="entradilla">
          Diez años en decoración y estilismo de espacios, y quince antes en el sector textil.
        </p>
        <p>Por eso miro el detalle: el tejido, la textura y la luz. Cada proyecto empieza escuchando cómo vives tu casa.</p>
      </div>
    </section>

    <section class="guia-banda">
      <a href="/guia/" class="guia-portada" aria-label="Ver la guía gratuita">
        <img src="https://storage.mlcdn.com/account_image/2740702/9lAAv6ogIw25MjTHjgybMGD18Evhsonu6sDpecSr.jpg" width="909" height="1287" alt="Portada de la guía Tu casa de revista, sin obras" loading="lazy" />
      </a>
      <div class="guia-texto">
        <p class="eyebrow">Guía gratuita</p>
        <h2>Tu casa de revista,<br /><em>sin obras</em></h2>
        <p>Las doce claves que se repiten en las casas que más nos gustan, con medidas y trucos para aplicarlas este fin de semana. Te la envío gratis a tu email.</p>
        <a class="boton lleno" href="/guia/">Descargar la guía</a>
      </div>
    </section>

    <section id="contacto" class="contacto">
      <p class="eyebrow">Contacto</p>
      <h2>¿Hablamos de <em>tu casa</em>?</h2>
      <p class="contacto-sub">Cuéntame qué espacio quieres cambiar y lo imaginamos juntas.</p>
      <p class="zonas-linea">Barcelona · Vallès · Maresme · Online</p>
      {site.llamada && (
        <p class="llamada">¿Prefieres hablarlo? <a class="enlace" href={site.llamada} target="_blank" rel="noopener">Primera llamada gratuita · 20 min</a></p>
      )}
      <Formulario />
      <div class="directo">
        <p class="eyebrow">¿Prefieres escribirme directamente?</p>
        <div class="acciones">
          {whatsappUrl && <a class="enlace" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>}
          {site.email && <a class="enlace" href={`mailto:${site.email}`}>{site.email}</a>}
          <a class="enlace" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; }
  h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.04; font-weight: 300; }
  em { font-style: italic; }
  figure { margin: 0; }
  figcaption {
    margin-top: 0.7rem;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; }

  /* Portada tipo doble página */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
    max-width: 1500px;
    margin: 0 auto;
  }
  h1 {
    font-weight: 300;
    font-size: clamp(3.2rem, 7.4vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  .sub {
    margin: 1.8rem 0 2.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    color: var(--tinta-suave);
  }
  .hero-foto img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 68% center; }

  /* Cita */
  .intro {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) var(--gutter);
    text-align: center;
    border-top: 1px solid var(--linea);
  }
  .cita {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.22;
  }
  .firma { margin: 1.6rem 0 0; font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--tinta-suave); }

  /* Cabeceras de sección tipo revista */
  .seccion-cab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--tinta);
  }
  .contador { font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 2.5vw, 2rem); color: var(--tinta-suave); }

  /* Proyectos */
  .proyectos { max-width: 1320px; margin: 0 auto; padding: 0 var(--gutter) clamp(5rem, 11vw, 9rem); }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .tarjeta { text-decoration: none; display: block; }
  .foto { overflow: hidden; aspect-ratio: 4 / 3; background: var(--arena); }
  .foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s ease; }
  .tarjeta:hover .foto img { transform: scale(1.025); }
  .tarjeta-pie { display: flex; justify-content: space-between; align-items: center; margin: 1.1rem 0 0.6rem; }
  .numero { font-size: 0.68rem; letter-spacing: 0.24em; color: var(--tinta-suave); }
  .tarjeta h3 { font-size: clamp(1.5rem, 2.2vw, 1.9rem); font-weight: 400; line-height: 1.1; }
  .tarjeta p { margin: 0.5rem 0 0; color: var(--tinta-suave); font-size: 0.95rem; max-width: 46ch; }

  .sobre-texto p:not(.eyebrow):not(.entradilla) {
    color: var(--tinta-suave);
    max-width: 46ch;
    margin: 0;
  }

  /* Servicios como índice */
  .servicios { max-width: 1320px; margin: 0 auto; padding: 0 var(--gutter) clamp(5rem, 11vw, 9rem); }
  .indice { list-style: none; margin: 0; padding: 0; }
  .indice li {
    display: grid;
    grid-template-columns: 4rem 1fr 1.3fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .num { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--tinta-suave); }
  .indice h3 { font-size: clamp(1.6rem, 2.8vw, 2.3rem); font-weight: 300; }
  .indice p { margin: 0; color: var(--tinta-suave); }
  .indice li:first-child h3 { font-style: italic; }

  /* Proceso */
  .proceso {
    background: var(--papel);
    padding: clamp(4.5rem, 10vw, 7.5rem) var(--gutter);
    text-align: center;
  }
  .proceso ol {
    list-style: none;
    margin: 2.5rem auto 0;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .paso-num { font-family: var(--serif); font-style: italic; font-size: 1.6rem; color: var(--tinta-suave); }
  .proceso h3 { font-size: clamp(2rem, 3.2vw, 2.6rem); font-weight: 300; margin: 0.4rem 0 0.8rem; }
  .proceso p { margin: 0 auto; color: var(--tinta-suave); max-width: 30ch; }

  /* Sobre mí */
  .sobre {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
  }
  .sobre-foto img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 40% top; }
  .sobre-texto h2 { margin-bottom: 1.6rem; }
  .entradilla {
    margin: 0 0 1.2rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.4;
  }

  /* Contacto */
  .contacto {
    text-align: center;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
    border-top: 1px solid var(--linea);
  }
  .contacto h2 { font-size: clamp(2.6rem, 7vw, 5.5rem); }
  .contacto-sub {
    margin: 1.4rem 0 2.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--tinta-suave);
  }
  .contacto .acciones { justify-content: center; }
  .directo { margin-top: clamp(3.5rem, 7vw, 5rem); padding-top: 2.5rem; border-top: 1px solid var(--linea); max-width: 760px; margin-left: auto; margin-right: auto; }
  .llamada { margin: 0 auto 3rem; font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--tinta-suave); display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0.6rem 1.2rem; }
  .llamada .enlace { font-family: var(--sans); font-style: normal; color: var(--tinta); }
  .directo .acciones { gap: 1.2rem 2.2rem; }
  h1 .eyebrow { display: block; font-family: var(--sans); font-size: 0.68rem; line-height: 1.7; letter-spacing: 0.34em; margin-bottom: 1.1rem; }
  .indice h3 a { text-decoration: none; }
  .indice h3 a:hover { font-style: italic; }
  .mas { display: table; margin-top: 0.9rem; color: var(--tinta); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-foto { order: -1; }
    .hero-foto img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 760px) {
    .rejilla { grid-template-columns: 1fr; }
    .sobre, .guia-banda { grid-template-columns: 1fr; }
    .guia-portada img { max-width: 240px; margin: 0 auto; }
    .indice li { grid-template-columns: 2.5rem 1fr; }
    .indice p, .sv-texto { grid-column: 2; }
    .proceso ol { grid-template-columns: 1fr; }
  }
  .guia-banda {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding: clamp(4rem, 9vw, 7rem) max(var(--gutter), calc((100% - 1080px) / 2));
    background: var(--papel);
  }
  .guia-portada img { width: 100%; max-width: 320px; margin-left: auto; box-shadow: 0 30px 60px -30px rgba(17, 17, 17, 0.35); transition: transform 0.4s; }
  .guia-portada:hover img { transform: translateY(-4px); }
  .guia-texto h2 { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.04; }
  .guia-texto h2 em { font-style: italic; }
  .guia-texto p:not(.eyebrow) { margin: 1.3rem 0 2.2rem; max-width: 34rem; font-family: var(--serif); font-size: 1.25rem; line-height: 1.5; color: var(--tinta-suave); }
  .modalidades { list-style: none; margin: 1.1rem 0 1.3rem; padding: 0; max-width: 30rem; }
  .modalidades li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--linea); font-family: var(--serif); font-size: 1.15rem; }
  .modalidades .pr { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tinta-suave); }
  .zonas-linea { margin: 0 0 2.5rem; font-size: 0.72rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--tinta-suave); }
</style>
