---
import Base from '../layouts/Base.astro';
---
<Base title="Gracias | Aesthetic Notes & Co" description="Tu mensaje ha llegado." noindex>
  <main class="gracias">
    <p class="eyebrow">Mensaje recibido</p>
    <h1>Gracias por <em>contarme tu casa</em></h1>
    <p class="sub">Lo leo con calma y te respondo personalmente en 24–48 h laborables.</p>
    <div class="acciones">
      <a class="boton lleno" href="/#proyectos">Ver proyectos</a>
      <a class="enlace" href="https://www.instagram.com/aestheticnotesandco/" target="_blank" rel="noopener">Instagram</a>
    </div>
  </main>
</Base>

<style>
  .gracias { min-height: 62vh; display: grid; place-content: center; justify-items: center; text-align: center; padding: clamp(5rem, 12vw, 9rem) var(--gutter); }
  h1 { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1.02; }
  em { font-style: italic; }
  .sub { margin: 1.6rem 0 2.8rem; font-family: var(--serif); font-style: italic; font-size: 1.4rem; color: var(--tinta-suave); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.6rem; }
</style>
