---
import Base from '../../layouts/Base.astro';
import { proyectos } from '../../data/proyectos.js';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, n: i + 1, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { p, n, siguiente } = Astro.props;
const [portada, ...resto] = p.fotos;
---
<Base title={`${p.titulo} · Proyecto de decoración de interiores | Aesthetic Notes — Interior Styling`} description={`${p.resumen} Proyecto de estilismo y decoración de interiores sin obras.`} image={portada}>
  <main>
    <section class="cabecera">
      <a href="/#proyectos" class="volver">← Proyectos</a>
      <p class="eyebrow">Proyecto Nº {String(n).padStart(2, '0')}</p>
      <h1>{p.titulo}</h1>
      <p class="resumen">{p.resumen}</p>
    </section>

    <img class="portada" src={portada} alt={`${p.titulo} — decoración de interiores sin obras`} fetchpriority="high" />

    <section class="detalle">
      <p class="texto">{p.texto}</p>
      <div class="muestras">
        <p class="eyebrow">La paleta</p>
        <ul>
          {p.paleta.map(([nombre, hex]) => (
            <li>
              <span class="punto" style={`background:${hex}`}></span>
              {nombre}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="galeria">
      {resto.map((src, i) => (
        <img src={src} alt={`${p.titulo} — estilismo de interiores, imagen ${i + 2}`} loading="lazy" />
      ))}
    </section>

    <section class="cierre">
      <p class="eyebrow">¿Te imaginas tu casa así?</p>
      <a class="boton lleno" href="/#contacto">Hablemos</a>
      <a class="siguiente" href={`/proyectos/${siguiente.slug}/`}>
        <span class="eyebrow">Siguiente proyecto</span>
        <em>{siguiente.titulo} →</em>
      </a>
    </section>
  </main>
</Base>

<style>
  .cabecera {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }
  .volver {
    display: inline-block;
    margin-bottom: 2.4rem;
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--tinta-suave);
  }
  h1 {
    margin: 0 0 1.2rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.8rem, 7.5vw, 6rem);
    line-height: 1;
  }
  .resumen {
    margin: 0 auto;
    max-width: 40ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: var(--tinta-suave);
  }
  .portada {
    width: calc(100% - 2 * var(--gutter));
    margin: 0 auto;
    max-height: 86vh;
    object-fit: cover;
  }
  .detalle {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--gutter);
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .texto {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    line-height: 1.4;
  }
  .texto::first-letter {
    float: left;
    font-size: 4.2em;
    line-height: 0.82;
    padding: 0.06em 0.1em 0 0;
  }
  .muestras { border-top: 1px solid var(--tinta); padding-top: 1.2rem; }
  .muestras ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .muestras li { display: flex; align-items: center; gap: 1rem; font-size: 0.92rem; }
  .punto { width: 30px; height: 30px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.08); flex-shrink: 0; }
  .galeria {
    columns: 2;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0 var(--gutter);
    max-width: 1400px;
    margin: 0 auto;
  }
  .galeria img { width: 100%; margin-bottom: clamp(1rem, 3vw, 2.5rem); break-inside: avoid; }
  .cierre {
    text-align: center;
    padding: clamp(4.5rem, 10vw, 7rem) var(--gutter);
    display: grid;
    justify-items: center;
    gap: 1.2rem;
  }
  .siguiente {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--linea);
    width: min(100%, 640px);
    text-decoration: none;
    display: grid;
    gap: 0.2rem;
  }
  .siguiente .eyebrow { margin: 0; }
  .siguiente em { font-family: var(--serif); font-weight: 300; font-size: clamp(1.8rem, 4vw, 2.8rem); }

  @media (max-width: 760px) {
    .detalle { grid-template-columns: 1fr; }
    .galeria { columns: 1; }
  }
</style>
