---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import { site } from '../data/site.js';
const {
  title = 'Decoradora de interiores en Barcelona, el Vallès y el Maresme | Aesthetic Notes & Co',
  description = 'Decoración y estilismo de interiores sin obras en Barcelona, Vallès Occidental, Vallès Oriental y Maresme, y asesoría online. Color, textiles y piezas a medida para que tu casa luzca en su mejor versión.',
  image = '/og.jpg',
  schema = null,
  noindex = false,
} = Astro.props;
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#negocio', Astro.site).href,
  name: site.nombre,
  description: 'Decoración y estilismo de interiores sin obras, asesoría de color y textil, asesoría online y personal shopper de decoración, estilismo para marcas y home staging.',
  url: Astro.site.href,
  image: new URL('/og.jpg', Astro.site).href,
  logo: new URL('/favicon.svg', Astro.site).href,
  priceRange: '€€',
  address: { '@type': 'PostalAddress', addressRegion: 'Barcelona', addressCountry: 'ES' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de decoración y estilismo de interiores',
    itemListElement: [
      'Decoración de interiores sin obras',
      'Asesoría de color y textil',
      'Estilismo para marcas',
      'Home staging',
      'Asesoría de decoración online y personal shopper',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
  founder: { '@type': 'Person', name: 'Marta', jobTitle: 'Estilista y decoradora de interiores' },
  areaServed: [
    { '@type': 'City', name: 'Barcelona' },
    { '@type': 'AdministrativeArea', name: 'Vallès Occidental' },
    { '@type': 'AdministrativeArea', name: 'Vallès Oriental' },
    { '@type': 'AdministrativeArea', name: 'Maresme' },
    { '@type': 'Country', name: 'España' },
  ],
  knowsAbout: ['Decoración de interiores', 'Estilismo de interiores', 'Home staging', 'Asesoría de color', 'Textil hogar', 'Decoración online'],
  sameAs: [site.instagram, site.houzz, site.google].filter(Boolean),
  ...(site.email ? { email: site.email } : {}),
  ...(site.whatsapp ? { telephone: '+' + site.whatsapp } : {}),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" /> <meta name="google-site-verification" content="_FW6LIGexVNxqIbn1mcivzVc_TY0yvxa5jivYYv8NzQ" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(extra.length ? [negocio, ...extra] : negocio)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="top">
      <nav class="nav-izq">
        <a href="/#proyectos">Proyectos</a>
        <a href="/#servicios">Servicios</a>
        <a href="/asesoria-personal-shopper/">Asesoría online</a>
      </nav>
      <a href="/" class="marca">Aesthetic Notes &amp; Co <span>Interior Styling</span></a>
      <nav class="nav-der">
        <a href="/#sobre">Sobre mí</a>
        <a href="/#contacto" class="cta">Contacto</a>
      </nav>
    </header>

    <slot />

    <footer>
      <a href="/" class="marca-pie">Aesthetic Notes &amp; Co <span>Interior Styling</span></a>
      <div class="pie-linea">
        <span>Decoración y estilismo de interiores · {site.zona}</span>
        <span class="pie-links">
          <a href="/asesoria-personal-shopper/">Asesoría online</a>
          <a href="/guia/">Guía gratuita</a>
          <a href="/privacidad/">Privacidad</a>
          <a href={site.instagram} target="_blank" rel="noopener">Instagram — @aestheticnotesandco</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --crema: #ffffff;
    --papel: #f4f3f1;
    --arena: #ebeae7;
    --tinta: #111111;
    --tinta-suave: #6b6b6b;
    --linea: #e4e4e2;
    --oro: #111111;
    --oro-claro: #111111;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Jost', system-ui, sans-serif;
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--crema);
    color: var(--tinta);
    font-family: var(--sans);
    font-weight: 300;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  ::selection { background: var(--arena); }

  .eyebrow {
    margin: 0 0 1.1rem;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .boton {
    display: inline-block;
    padding: 0.95rem 2.1rem;
    border: 1px solid var(--tinta);
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s, color 0.3s;
  }
  .boton:hover { background: var(--tinta); color: var(--crema); }
  .boton.lleno { background: var(--tinta); color: var(--crema); }
  .boton.lleno:hover { background: transparent; color: var(--tinta); }
  .enlace {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--tinta);
    padding-bottom: 3px;
  }

  .paleta { display: flex; gap: 6px; }
  .paleta span { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(0,0,0,0.08); }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem var(--gutter);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--linea);
  }
  .marca, .marca-pie {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.2rem;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.3em;
    white-space: nowrap;
  }
  .marca, .marca-pie { display: inline-flex; flex-direction: column; align-items: center; line-height: 1.15; }
  .marca span, .marca-pie span {
    margin-top: 0.35em;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.42em;
    letter-spacing: 0.42em;
    padding-left: 0.42em;
    color: var(--tinta-suave);
  }
  .top nav { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2.2rem); }
  .nav-der { justify-content: flex-end; }
  .top nav a {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--tinta-suave);
  }
  .top nav a:hover, .top nav .cta { color: var(--tinta); }
  .top nav .cta { border-bottom: 1px solid var(--tinta); padding-bottom: 2px; }

  footer {
    padding: clamp(3rem, 7vw, 5rem) var(--gutter) 1.6rem;
    text-align: center;
    border-top: 1px solid var(--linea);
  }
  .marca-pie { font-size: clamp(1.2rem, 3.4vw, 2.2rem); display: inline-block; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .pie-linea {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--linea);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .pie-linea a { text-decoration: none; }
  .pie-links { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 1.8rem; }

  @media (max-width: 760px) {
    .top { grid-template-columns: auto 1fr; }
    .nav-izq, .nav-der a:not(.cta) { display: none !important; }
    .marca { font-size: 0.92rem; letter-spacing: 0.2em; align-items: flex-start; }
    .marca span { padding-left: 0; }
    .pie-linea { justify-content: center; text-align: center; }
    .marca-pie { display: inline-flex; flex-direction: column; align-items: center; max-width: 100%; font-size: 1.15rem; letter-spacing: 0.18em; }
    .marca-pie span { letter-spacing: 0.3em; }
  }
</style>
